# Environment Configuration Template
# Copy this file to .env and fill in your values

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
API_VERSION=v1

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# API Key (REQUIRED) - used by frontend and iOS app to authenticate requests
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_api_key_here

# External Services
# OPENAI_API_KEY=your_api_key_here

# Anthropic Claude API (REQUIRED)
# Get your API key from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your_api_key_here

# Database
# PostgreSQL connection URL with async driver (postgresql+asyncpg://)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://life_organizer:life_organizer@localhost:5432/life_organizer

# iOS Integration (future)
# ICLOUD_USERNAME=
# ICLOUD_PASSWORD=

# Excel/File Storage (future)
# STORAGE_PATH=/path/to/storage
